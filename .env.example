# Copy to .env and fill in what you need. Everything is optional:
# with no keys, Conduit runs fully offline (extractive answers, local embeddings).

# Chat model: any OpenAI-compatible endpoint. Groq has a free tier.
CONDUIT_LLM_BASE_URL=https://api.groq.com/openai/v1
CONDUIT_LLM_API_KEY=
CONDUIT_LLM_MODEL=llama-3.3-70b-versatile
# Gemini instead:  CONDUIT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  CONDUIT_LLM_MODEL=gemini-2.5-flash
# OpenAI instead:  CONDUIT_LLM_BASE_URL=https://api.openai.com/v1   CONDUIT_LLM_MODEL=gpt-4o-mini

# Embeddings: "local" (no network) or a model on an OpenAI-compatible endpoint.
CONDUIT_EMBED_MODEL=local
# CONDUIT_EMBED_MODEL=text-embedding-3-small
# CONDUIT_EMBED_BASE_URL=https://api.openai.com/v1
# CONDUIT_EMBED_API_KEY=

# Optional live integrations
# CONDUIT_GITHUB_REPO=fastapi/fastapi
# CONDUIT_GITHUB_TOKEN=
# CONDUIT_SLACK_WEBHOOK_URL=
